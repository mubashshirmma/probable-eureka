# Copy this file to .env and fill in your own values. Never commit .env.
# The key is read by the Express server only. It is never sent to the browser.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Text model: used for typed notes and for text taken from PDFs.
# IMPORTANT: Groq's docs page can list models that your key cannot use. For example
# llama-3.3-70b-versatile is documented but returned HTTP 404 "model_not_found" for our key.
# The live list is the truth. List the models your key can use with:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# The server also checks this list at startup and prints a warning if a model is missing.
# openai/gpt-oss-120b was tested with this app (about 4 seconds per study set).
GROQ_MODEL=openai/gpt-oss-120b

# Vision model: used only when the student uploads photos (JPG, PNG, WebP; up to 3).
# qwen/qwen3.8-27b is listed by Groq as a preview model with image input.
# Leave empty to turn photo uploads off (PDFs and typed notes still work).
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Most characters of typed notes plus PDF text sent to the model at once.
# Groq limits tokens per minute per model, so keep this modest on a free plan.
# Longer material is rejected with a clear message, never silently cut.
GROQ_MAX_INPUT_CHARS=20000

# Port for the Express server. The Vite dev proxy reads this same value.
# 3000 and 3001 are avoided because VS Code and other tools often use them.
PORT=8787
