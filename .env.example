# Copy this file to .env and fill in your own values. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Any model your key can use for generateContent. List them with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
# gemini-2.5-flash is a stable choice; newer flash models also work.
GEMINI_MODEL=gemini-2.5-flash

# Port for the Express server (the Vite dev proxy expects 3001).
PORT=3001
